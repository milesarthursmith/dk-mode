__pycache__/
*.pyc

# An install into this repo writes here. dk.jsonl holds mined conversation
# text: a real run once mined a live API key out of a transcript before
# redaction existed, so this must never be committable by accident.
.claude/*
!.claude/settings.json
!.claude/hooks/

.env
*.log
.DS_Store

# Eval working state: the throwaway monitor memory an arms.py run seeds, and
# the raw inspect logs (large). The distilled numbers ARE committed - in
# evals/results.md and evals/results/<date>/ - so a run stays re-derivable.
evals/impossiblebench/.dk_mem/
evals/impossiblebench/logs/
evals/math/logs/
evals/math/band.json
evals/hooked/logs/
evals/lcb/logs/
evals/swe/logs/

# The hooked sandbox stages a copy of the plugin at build time.
evals/hooked/plugin/
evals/swe/pulled60.txt
evals/goal/ca-bundle.crt
evals/bench/results.jsonl
evals/bench/.mem/
evals/bench/.mem*/
evals/bench/.stage1_*.log
evals/bench/tb_cache/
evals/bench/.shard*/
evals/react/.build_*.json
evals/react/.counter_mem/
